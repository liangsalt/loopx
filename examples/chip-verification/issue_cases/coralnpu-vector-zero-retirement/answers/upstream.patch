diff --git a/tests/cocotb/rvv/rvv_vl0_v0_corruption_test.S b/tests/cocotb/rvv/rvv_vl0_v0_corruption_test.S
new file mode 100644
index 0000000000000000000000000000000000000000..a93eabccb29dffa47a3d7c3620ba5e17fdc842eb
--- /dev/null
+++ b/tests/cocotb/rvv/rvv_vl0_v0_corruption_test.S
@@ -0,0 +1,100 @@
+/*
