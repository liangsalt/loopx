+// limitations under the License.
+
+#include <cstdint>
+
+volatile uint32_t sink0 = 10;
+volatile uint32_t sink1 = 20;
+
+int main() {
+  // Verify standard FENCE encodings.
+  sink0 = 1;
+  asm volatile("fence rw, rw" ::: "memory");
+  sink1 = sink0 + 1;
+  asm volatile("fence r, r" ::: "memory");
+  sink0 = sink1 + 1;
+  asm volatile("fence w, w" ::: "memory");
+  asm volatile("fence iorw, iorw" ::: "memory");
+
+  // Verify FENCE.TSO (0x8330000f) across all 4 fetch/dispatch lane alignments
+  // and adjacent to load/store traffic.
+  asm volatile(
+      ".balign 16\n\t"
+      "fence.tso\n\t"
+      "nop\n\t"
+      "nop\n\t"
+      "nop\n\t"
+      ".balign 16\n\t"
+      "nop\n\t"
+      "fence.tso\n\t"
+      "nop\n\t"
+      "nop\n\t"
+      ".balign 16\n\t"
+      "nop\n\t"
+      "nop\n\t"
+      "fence.tso\n\t"
+      "nop\n\t"
+      ".balign 16\n\t"
+      "nop\n\t"
+      "nop\n\t"
+      "nop\n\t"
+      "fence.tso\n\t" ::
+          : "memory");
+
+  sink0 = 42;
+  asm volatile("fence.tso" ::: "memory");
+  uint32_t v = sink0;
+  asm volatile("fence.tso" ::: "memory");
+  sink1 = v;
+
+  return (sink1 == 42) ? 0 : 1;
+}
